)","var.floor_child_front_right_leg":"if(is_in_water || sqrt(var.position_check_child_front_right_leg_y * var.position_check_child_front_right_leg_y + var.position_check_child_front_right_leg_z * var.position_check_child_front_right_leg_z) * sin(-child_front_right_leg2.rx + atan2(var.position_check_child_front_right_leg_y, var.position_check_child_front_right_leg_z)) <= 20 - child_front_right_leg.ty + -4.5 * sin(child_front_right_leg2.rx + pi / 2), 1, 0.5)","var.floor_child_back_left_leg":"if(is_in_water || sqrt(var.position_check_child_back_left_leg_y * var.position_check_child_back_left_leg_y + var.position_check_child_back_left_leg_z * var.position_check_child_back_left_leg_z) * sin(-child_back_left_leg2.rx + atan2(var.position_check_child_back_left_leg_y, var.position_check_child_back_left_leg_z)) <= 20 - child_back_left_leg.ty + -4.5 * sin(child_back_left_leg2.rx + pi / 2), 1, 0.5)","var.floor_child_back_right_leg":"if(is_in_water || sqrt(var.position_check_child_back_right_leg_y * var.position_check_child_back_right_leg_y + var.position_check_child_back_right_leg_z * var.position_check_child_back_right_leg_z) * sin(-child_back_right_leg2.rx + atan2(var.position_check_child_back_right_leg_y, var.position_check_child_back_right_leg_z)) <= 20 - child_back_right_leg.ty + -4.5 * sin(child_back_right_leg2.rx + pi / 2), 1, 0.5)"},{"var.velocity_head_tx":"if(death_time > 0, var.floor_head * var.velocity_head_tx - var.first_frame * (random() - 0.5) * if(is_in_water, 2, 4), 0)","var.velocity_head_ty":"if(death_time > 0, if(var.floor_head == 1, 1, -var.floor_head) * var.velocity_head_ty + var.a * var.deltatime - var.first_frame * random() * if(is_in_water, 1, 2), 0)","var.velocity_head_tz":"if(death_time > 0, var.floor_head * var.velocity_head_tz - var.first_frame * (random() - 0.5) * if(is_in_water, 2, 4), 0)","var.velocity_head_rx":"if(death_time > 0, var.floor_head * var.velocity_head_rx - var.first_frame * (random() - 0.5) * if(is_in_water, 0.5, 1), 0)","var.velocity