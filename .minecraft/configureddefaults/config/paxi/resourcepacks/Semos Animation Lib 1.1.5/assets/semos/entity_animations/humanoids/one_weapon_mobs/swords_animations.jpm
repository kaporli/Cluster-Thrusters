{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{
			"var.aim":"0",
			"var.sword_left_arm_rx": "if(var.aggro>0.01&&swing_progress==0,torad(-300-sin(age/10)*5),if(var.aggro>0.01&&swing_progress!=0,clamp(torad(250)-(todeg(-swing_progress/10)),torad(250),torad(420)),torad(35)))",
			"var.sword_left_arm_ry": "if(var.aggro>0.01&&swing_progress==0,torad(sin(age/10)*5),if(var.aggro>0.01&&swing_progress!=0,torad(-10),torad(180)))",
			"var.sword_left_arm_rz": "if(var.aggro>0.01&&swing_progress==0,torad(-45),if(var.aggro>0.01&&swing_progress!=0,torad(-45),torad(0)))",
			"var.sword_left_arm_tx": "if(var.aggro>0.01&&swing_progress==0,5.75,if(var.aggro>0.01&&swing_progress!=0,5.75,if(nbt(Inventory,raw:iregex:.*(leggings|chestplate).*),-4.5,-3.5)))",
			"var.sword_left_arm_ty": "if(var.aggro>0.01&&swing_progress==0,25,if(var.aggro>0.01&&swing_progress!=0,24,24))",
			"var.sword_left_arm_tz": "if(var.aggro>0.01&&swing_progress==0,0.5,if(var.aggro>0.01&&swing_progress!=0,0.75,0.75))",
			"var.sword_right_arm_rx": "if(var.aggro>0.01&&swing_progress==0,torad(-300-sin(age/10)*5),if(var.aggro>0.01&&swing_progress!=0,clamp(torad(250)-(todeg(-swing_progress/10)),torad(250),torad(420)),torad(35)))",
			"var.sword_right_arm_ry": "if(var.aggro>0.01&&swing_progress==0,torad(sin(age/10)*5),if(var.aggro>0.01&&swing_progress!=0,-sin(swing_progress*pi),torad(180)))",
			"var.sword_right_arm_rz": "if(var.aggro>0.01&&swing_progress==0,torad(45),if(var.aggro>0.01&&swing_progress!=0,torad(0),torad(0)))",
			"var.sword_right_arm_tx": "if(var.aggro>0.01&&swing_progress==0,-5.75,if(var.aggro>0.01&&swing_progress!=0,-5.75,if(nbt(Inventory,raw:iregex:.*(leggings|chestplate).*),4.5,3.5)))",
			"var.sword_right_arm_ty": "if(var.aggro>0.01&&swing_progress==0,25,if(var.aggro>0.01&&swing_progress!=0,24,24))",
			"var.sword_right_arm_tz": "if(var.aggro>0.01&&swing_progress==0,0.5,if(var.aggro>0.01&&swing_progress!=0,0.75,0.75))"
		},
		{
			"right_arm.rx": "if(is_right_handed,if(var.sword==1,var.sword_right_arm_rx,var.right_arm_idle_rx),if(var.shield==1,var.shield_right_arm_rx,var.right_arm_idle_rx))+main_body.rx",
			"right_arm.ry": "if(is_right_handed,if(var.sword==1,var.sword_right_arm_ry,var.right_arm_idle_ry),if(var.shield==1,var.shield_right_arm_ry,var.right_arm_idle_ry))+main_body.ry",
			"right_arm.rz": "if(is_right_handed,if(var.sword==1,var.sword_right_arm_rz,var.right_arm_idle_rz),if(var.shield==1,var.shield_right_arm_rz,var.right_arm_idle_rz))+main_body.rz",
			"right_arm.tx": "if(is_right_handed,if(var.sword==1,var.sword_right_arm_tx,var.right_arm_idle_tx),if(var.shield==1,var.shield_right_arm_tx,var.right_arm_idle_tx))+main_body.tx",
			"right_arm.ty": "if(is_right_handed,if(var.sword==1,var.sword_right_arm_ty,var.right_arm_idle_ty),if(var.shield==1,var.shield_right_arm_ty,var.right_arm_idle_ty))+main_body.ty",
			"right_arm.tz": "if(is_right_handed,if(var.sword==1,var.sword_right_arm_tz,var.right_arm_idle_tz),if(var.shield==1,var.shield_right_arm_tz,var.right_arm_idle_tz))+main_body.tz",
			
			"left_arm.rx": "if(is_right_handed,if(var.shield==1,var.shield_left_arm_rx,var.left_arm_idle_rx),if(var.sword==1,var.sword_left_arm_rx,var.left_arm_idle_rx))+main_body.rx",
			"left_arm.ry": "if(is_right_handed,if(var.shield==1,var.shield_left_arm_ry,var.left_arm_idle_ry),if(var.sword==1,var.sword_left_arm_ry,var.left_arm_idle_ry))+main_body.ry",
			"left_arm.rz": "if(is_right_handed,if(var.shield==1,var.shield_left_arm_rz,var.left_arm_idle_rz),if(var.sword==1,var.sword_left_arm_rz,var.left_arm_idle_rz))+main_body.rz",
			"left_arm.tx": "if(is_right_handed,if(var.shield==1,var.shield_left_arm_tx,var.left_arm_idle_tx),if(var.sword==1,var.sword_left_arm_tx,var.left_arm_idle_tx))+main_body.tx",
			"left_arm.ty": "if(is_right_handed,if(var.shield==1,var.shield_left_arm_ty,var.left_arm_idle_ty),if(var.sword==1,var.sword_left_arm_ty,var.left_arm_idle_ty))+main_body.ty",
			"left_arm.tz": "if(is_right_handed,if(var.shield==1,var.shield_left_arm_tz,var.left_arm_idle_tz),if(var.sword==1,var.sword_left_arm_tz,var.left_arm_idle_tz))+main_body.tz"
		}
