{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
	     {
            "var.r": "(pi*random(id)*4) +(limb_swing/20)*0",
            "var.b": "age /(11 -random(id)*2)",
            "var.ls": "limb_swing/if( limb_speed>0.85, 1, 1.2 )",
            "var.nov2": "clamp(-19 +cos(-pi/4 +var.r +var.b/10)*20, 0, 1)*clamp(1-limb_speed*2, 0, 1)",
            "var.spell": "clamp(if(right_arm.visible, min(20, var.spell +0.1 *frame_time*20), max(0, var.spell -0.1 *frame_time*20)), 0, 1)",
            "var.cast": "var.r+age/(1.4 +0.4*random(id))"
        },
		{
			"fake_folded_arms.sx": "1-clamp(-3.5+var.spell*6, 0, 1)",
			"fake_folded_arms.sy": "fake_folded_arms.sx",
			"fake_folded_arms.sz": "fake_folded_arms.sx",
			"fake_folded_arms.rx": "if(!is_riding&&!is_on_ground&&is_in_water, sin(pi/4+var.swim*2  )/16 -torad(20) -body.rx, (-sin(torad(-45)+var.ls*2 -sin(var.ls*2)/3)/8 -torad(5 +15*random(id)))*limb_speed ) +cos(pi/4 +var.ls*2)/8*var.dance +torad(-40 -15*random(id)) +( sin(-pi/3 +var.r+var.b +sin(var.r+var.b) )/6 )*var.nov2 +(sin(limb_swing/2) -pi/4)/2*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0) +torad(5)*var.nov3+main_body.rx",
			"fake_folded_arms.ry": "if(!is_riding&&!is_on_ground&&is_in_water, sin(pi/4+var.swim  +sin(pi/4+var.swim*2)/3)/6,  -sin(torad( 45)+var.ls)/3*limb_speed*var.run *if(between(random(id), 0.4, 0.5), 0, 1)) -sin(var.ls)/4*var.dance +clamp(torad(head_yaw)/6*clamp(1-limb_speed*2, 0, 1), -pi/8, pi/8) +sin(-pi/2+age*0.45)/10*var.nope+main_body.ry",
			"fake_folded_arms.rz": "0+main_body.rz",
			"fake_folded_arms.tx": "0+main_body.tx",
			"fake_folded_arms.ty": "25+sin(var.r +var.b-torad(60))/7 +( cos(-pi/3 +var.r+var.b +sin(var.r+var.b)*1.5) -0.8 )*var.nov2+main_body.ty",
			"fake_folded_arms.tz": "-0.5*random(id)+main_body.tz"
		},
		{
			"fake_left_arm.sx": " clamp(-3+var.spell*6, 0, 1)",
			"fake_left_arm.sy": "  fake_left_arm.sx",
			"fake_left_arm.sz": "  fake_left_arm.sx",
			"fake_right_arm.sx": "clamp(-3+var.spell*6, 0, 1)",
			"fake_right_arm.sy": "fake_right_arm.sx",
			"fake_right_arm.sz": "fake_right_arm.sx"		
		}
	]
}