{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{			
			"right_arm.rx": "if(is_right_handed,var.book_right_arm_rx,right_arm.rx)+main_body.rx",
			"right_arm.ry": "if(is_right_handed,var.book_right_arm_ry,right_arm.ry)+main_body.ry",
			"right_arm.rz": "if(is_right_handed,var.book_right_arm_rz,right_arm.rz)+main_body.rz",
			"right_arm.tx": "if(is_right_handed,var.book_right_arm_tx,right_arm.tx)+main_body.tx",
			"right_arm.ty": "if(is_right_handed,var.book_right_arm_ty,right_arm.ty)+main_body.ty",
			"right_arm.tz": "if(is_right_handed,var.book_right_arm_tz,right_arm.tz)+main_body.tz",			
			"left_arm.rx": "if(!is_right_handed,var.book_left_arm_rx,left_arm.rx)+main_body.rx",
			"left_arm.ry": "if(!is_right_handed,var.book_left_arm_ry,left_arm.ry)+main_body.ry",
			"left_arm.rz": "if(!is_right_handed,var.book_left_arm_rz,left_arm.rz)+main_body.rz",
			"left_arm.tx": "if(!is_right_handed,var.book_left_arm_tx,left_arm.tx)+main_body.tx",
			"left_arm.ty": "if(!is_right_handed,var.book_left_arm_ty,left_arm.ty)+main_body.ty",
			"left_arm.tz": "if(!is_right_handed,var.book_left_arm_tz,left_arm.tz)+main_body.tz"
		}
	]
}