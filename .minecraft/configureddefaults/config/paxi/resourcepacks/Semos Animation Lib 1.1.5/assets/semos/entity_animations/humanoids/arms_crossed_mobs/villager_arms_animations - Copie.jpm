{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{
			"var.cross_arms1": "if(is_in_water, 0,is_hovered, 1, varb.show_item,1, limb_speed>0.1, 0, !varb.sleeping,sin((10*sin(0.5*(random(id)+age/200)-1)))+sin(5*(random(id)+age/200)-1),0)"
		},
		{
			"right_arms_top.rx": "if(var.cross_arms1>0,if(varb.slim_skin,torad(-25),torad(-20))+if(!is_riding&&!is_on_ground&&is_in_water, sin(pi/4+var.swim*2  )/16 -torad(20) -body.rx, (-sin(torad(-45)+var.ls*2 -sin(var.ls*2)/3)/8 -torad(5 +15*random(id)))*limb_speed ) +cos(pi/4 +var.ls*2)/8*var.dance +torad(-40 -15*random(id)) +( sin(-pi/3 +var.r+var.b +sin(var.r+var.b) )/6 )*var.nov2 +(sin(limb_swing/2) -pi/4)/2*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0) +torad(5)*var.nov3+main_body.rx,if(!is_riding&&!is_on_ground&&is_in_water,torad(-50) -cos(var.swim)/4*clamp(1-limb_speed*8, 0, 1) +(cos(var.swim +sin(var.swim)) +torad(30))*clamp(limb_speed*8, 0, 1), if(is_riding, torad(-45), -sin(var.ls)*limb_speed ) +torad(head_yaw)/8 )   +torad(5)*var.pose +( -sin(-pi/3 +var.r+var.b +sin(var.r+var.b) )/6 )*var.nov2   +(sin(limb_swing/2) -pi/4)/2*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0)",
			"right_arms_top.ry": "if(var.cross_arms1>0,0,if(!is_riding&&!is_on_ground&&is_in_water,torad( 30) -sin(var.swim +cos(var.swim)/4)  *clamp(1-limb_speed*8, 0, 1) +(torad( 5) +cos(pi/8 +var.swim +sin(var.swim)/2 )/2 +clamp(-sin(var.swim),-pi/2, 0) )*clamp(limb_speed*8, 0, 1), if(is_riding, -torad(20), 0) -torad(15)*clamp(limb_speed*4, 0, 1) +cos(var.r +var.b)/30 ) -torad(5)*var.pose)",
			"right_arms_top.rz": "if(var.cross_arms1>0,main_body.rz,if(!is_riding&&!is_on_ground&&is_in_water, -cos(var.swim)/2 +(torad( 20) +cos(var.swim)/2)  *clamp(  limb_speed*8, 0, 1), 0 ) -torad(head_pitch)/14 +torad( 8 +0.5 *var.pose)",
			"right_arms_top.tx": "if(!is_riding&&!is_on_ground&&is_in_water,0,0)",
			"right_arms_top.ty": "if(var.cross_arms1>0,25.5,if(!is_riding&&!is_on_ground&&is_in_water,1,if(is_riding, 26.8,26.8)))+main_body.ty",
			"right_arms_top.tz": "if(var.cross_arms1>0,-1.5,if(!is_riding&&!is_on_ground&&is_in_water,0,-0.5))+if(limb_speed>0.1,-main_body.tz,+main_body.tz)",
			"right_arms_bottom.rz": "if(var.cross_arms1>0,torad(-90),torad(0))",
			
			"left_arms_top.rx": "if(var.cross_arms1>0,if(varb.slim_skin,torad(-25),torad(-20))+if(!is_riding&&!is_on_ground&&is_in_water, sin(pi/4+var.swim*2  )/16 -torad(20) -body.rx, (-sin(torad(-45)+var.ls*2 -sin(var.ls*2)/3)/8 -torad(5 +15*random(id)))*limb_speed ) +cos(pi/4 +var.ls*2)/8*var.dance +torad(-40 -15*random(id)) +( sin(-pi/3 +var.r+var.b +sin(var.r+var.b) )/6 )*var.nov2 +(sin(limb_swing/2) -pi/4)/2*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0) +torad(5)*var.nov3+main_body.rx,if(!is_riding&&!is_on_ground&&is_in_water,torad(-50) -cos(var.swim)/4*clamp(1-limb_speed*8, 0, 1) +(cos(var.swim +sin(var.swim)) +torad(30))*clamp(limb_speed*8, 0, 1), if(is_riding, torad(-45),  sin(var.ls)*limb_speed ) -torad(head_yaw)/8 )   +torad( 5 )*var.pose +( -sin(-pi/3 +var.r+var.b +sin(var.r+var.b) )/6 )*var.nov2   +(sin(limb_swing/2) -pi/4)/2*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0)",
			"left_arms_top.ry": "if(var.cross_arms1>0,0,if(!is_riding&&!is_on_ground&&is_in_water,torad(-30) +sin(var.swim +cos(var.swim)/4)  *clamp(1-limb_speed*8, 0, 1) +(torad(-5) -cos(pi/8 +var.swim +sin(var.swim)/2 )/2 +clamp( sin(var.swim), 0, pi/2) )*clamp(limb_speed*8, 0, 1), if(is_riding,  torad(20), 0) +torad(15)*clamp(limb_speed*4, 0, 1) -cos(var.r +var.b)/30 ) +torad( 5)*var.pose)",
			"left_arms_top.rz": "if(var.cross_arms1>0,0,if(!is_riding&&!is_on_ground&&is_in_water, cos(var.swim)/2 +(torad(-20) -cos(var.swim)/2)  *clamp(  limb_speed*8, 0, 1), 0 ) +torad(head_pitch)/14 +torad(-8 +0.5*var.pose)",
			"left_arms_top.tx": "if(!is_riding&&!is_on_ground&&is_in_water,0,0)",
			"left_arms_top.ty": "if(var.cross_arms1>0,25.5,if(!is_riding&&!is_on_ground&&is_in_water,1,if(is_riding, 26.8, 26.8)))+main_body.ty",
			"left_arms_top.tz": "if(var.cross_arms1>0,-1.5,if(!is_riding&&!is_on_ground&&is_in_water,0,-0.5))+if(limb_speed>0.1,-main_body.tz,+main_body.tz)",
			"left_arms_bottom.rz": "if(var.cross_arms1>0,torad(90),torad(0))"
