		},
		{
			"left_arm.rx": "if(is_right_handed,(if(var.sword_offhand==1,var.sword_left_arm_rx,var.shield_offhand==1,var.shield_left_arm_rx,left_arm.rx)),(if(var.sword==1,var.sword_left_arm_rx,var.shield==1,var.shield_left_arm_rx,left_arm.rx)))+main_body.rx",
			"left_arm.ry": "if(is_right_handed,(if(var.sword_offhand==1,var.sword_left_arm_ry,var.shield_offhand==1,var.shield_left_arm_ry,left_arm.ry)),(if(var.sword==1,var.sword_left_arm_ry,var.shield==1,var.shield_left_arm_ry,left_arm.ry)))+main_body.ry",
