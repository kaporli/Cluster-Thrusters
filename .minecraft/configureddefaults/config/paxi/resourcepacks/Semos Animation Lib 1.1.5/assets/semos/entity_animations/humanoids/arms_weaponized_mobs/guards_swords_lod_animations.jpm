			"right_arm.rx": "if(is_right_handed,(if(var.sword==1,var.sword_right_arm_rx,var.shield==1,var.shield_right_arm_rx,right_arm.rx)),(if(var.sword_offhand==1,var.sword_right_arm_rx,var.shield_offhand==1,var.shield_right_arm_rx,right_arm.rx)))+main_body.rx",
			"right_arm.ry": "if(is_right_handed,(if(var.sword==1,var.sword_right_arm_ry,var.shield==1,var.shield_right_arm_ry,right_arm.ry)),(if(var.sword_offhand==1,var.sword_right_arm_ry,var.shield_offhand==1,var.shield_right_arm_ry,right_arm.ry)))+main_body.ry",
			"right_arm.rz": "if(is_right_handed,(if(var.sword==1,var.sword_right_arm_rz,var.shield==1,var.shield_right_arm_rz,right_arm.rz)),(if(var.sword_offhand==1,var.sword_right_arm_rz,var.shield_offhand==1,var.shield_right_arm_rz,right_arm.rz)))+main_body.rz",
			"right_arm.tx": "if(is_right_handed,(if(var.sword==1,var.sword_right_arm_tx,var.shield==1,var.shield_right_arm_tx,right_arm.tx)),(if(var.sword_offhand==1,var.sword_right_arm_tx,var.shield_offhand==1,var.shield_right_arm_tx,right_arm.tx)))+main_body.tx",
