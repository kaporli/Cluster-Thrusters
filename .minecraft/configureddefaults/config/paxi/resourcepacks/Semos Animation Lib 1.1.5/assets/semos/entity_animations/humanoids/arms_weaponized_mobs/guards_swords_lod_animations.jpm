			"left_arm.tx": "if(is_right_handed,(if(var.sword_offhand==1,var.sword_left_arm_tx,var.shield_offhand==1,var.shield_left_arm_tx,left_arm.tx)),(if(var.sword==1,var.sword_left_arm_tx,var.shield==1,var.shield_left_arm_tx,left_arm.tx)))+main_body.tx",
			"left_arm.ty": "if(is_right_handed,(if(var.sword_offhand==1,var.sword_left_arm_ty,var.shield_offhand==1,var.shield_left_arm_ty,left_arm.ty+24)),(if(var.sword==1,var.sword_left_arm_ty,var.shield==1,var.shield_left_arm_ty,left_arm.ty+24)))+main_body.ty",
