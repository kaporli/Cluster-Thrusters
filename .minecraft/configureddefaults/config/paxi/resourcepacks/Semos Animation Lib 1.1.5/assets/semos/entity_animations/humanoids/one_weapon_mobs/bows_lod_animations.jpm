{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{
			"var.bow_right_handed_right_arm_rx": "if(is_aggressive,right_arm.rx,torad(0))",
			"var.bow_right_handed_right_arm_ry": "if(is_aggressive,right_arm.ry,torad(100))",
			"var.bow_right_handed_right_arm_rz": "if(is_aggressive,right_arm.rz,torad(135))",
			"var.bow_right_handed_right_arm_tx": "if(is_aggressive,right_arm.tx,5)",
			"var.bow_right_handed_right_arm_ty": "if(is_aggressive,right_arm.ty+24,35)",
			"var.bow_right_handed_right_arm_tz": "if(is_aggressive,right_arm.tz,2)",
			
			"var.bow_left_handed_left_arm_rx": "if(is_aggressive,left_arm.rx,torad(0))",
			"var.bow_left_handed_left_arm_ry": "if(is_aggressive,left_arm.ry,torad(80))",
			"var.bow_left_handed_left_arm_rz": "if(is_aggressive,left_arm.rz,torad(-135))",
			"var.bow_left_handed_left_arm_tx": "if(is_aggressive,left_arm.tx,-5)",
			"var.bow_left_handed_left_arm_ty": "if(is_aggressive,left_arm.ty+24,35)",
			"var.bow_left_handed_left_arm_tz": "if(is_aggressive,left_arm.tz,2)"
		},
		{
			"fake_left_arm.rx": "left_arm.rx",
			"fake_left_arm.ry": "left_arm.ry",
			"fake_left_arm.rz": "left_arm.rz",
			"fake_left_arm.tx": "left_arm.tx",
			"fake_left_arm.ty": "left_arm.ty",
			"fake_left_arm.tz": "left_arm.tz",
			"fake_right_arm.rx": "right_arm.rx",
			"fake_right_arm.ry": "right_arm.ry",
			"fake_right_arm.rz": "right_arm.rz",
			"fake_right_arm.tx": "right_arm.tx",
			"fake_right_arm.ty": "right_arm.ty",
			"fake_right_arm.tz": "right_arm.tz"
		},
		{
			"right_arm.rx": "if(is_right_handed,if(var.bow==1,var.bow_right_handed_right_arm_rx,right_arm.rx),right_arm.rx)+main_body.rx",
			"right_arm.ry": "if(is_right_handed,if(var.bow==1,var.bow_right_handed_right_arm_ry,right_arm.ry),right_arm.ry)+main_body.ry",
			"right_arm.rz": "if(is_right_handed,if(var.bow==1,var.bow_right_handed_right_arm_rz,right_arm.rz),right_arm.rz)+main_body.rz",
			"right_arm.tx": "if(is_right_handed,if(var.bow==1,var.bow_right_handed_right_arm_tx,right_arm.tx),right_arm.tx)+main_body.tx",
			"right_arm.ty": "if(is_right_handed,if(var.bow==1,var.bow_right_handed_right_arm_ty,right_arm.ty),right_arm.ty)+main_body.ty",
			"right_arm.tz": "if(is_right_handed,if(var.bow==1,var.bow_right_handed_right_arm_tz,right_arm.tz),right_arm.tz)+main_body.tz",
			"left_arm.rx": "if(is_right_handed,left_arm.rx,if(var.bow==1,var.bow_left_handed_left_arm_rx,left_arm.rx))+main_body.rx",
			"left_arm.ry": "if(is_right_handed,left_arm.ry,if(var.bow==1,var.bow_left_handed_left_arm_ry,left_arm.ry))+main_body.ry",
			"left_arm.rz": "if(is_right_handed,left_arm.rz,if(var.bow==1,var.bow_left_handed_left_arm_rz,left_arm.rz))+main_body.rz",
			"left_arm.tx": "if(is_right_handed,left_arm.tx,if(var.bow==1,var.bow_left_handed_left_arm_tx,left_arm.tx))+main_body.tx",
			"left_arm.ty": "if(is_right_handed,left_arm.ty,if(var.bow==1,var.bow_left_handed_left_arm_ty,left_arm.ty))+main_body.ty",
			"left_arm.tz": "if(is_right_handed,left_arm.tz,if(var.bow==1,var.bow_left_handed_left_arm_tz,left_arm.tz))+main_body.tz"
		},
		{
			"var.armor_left_arm_rx": "fake_left_arm.rx",
			"var.armor_left_arm_ry": "fake_left_arm.ry",
			"var.armor_left_arm_rz": "fake_left_arm.rz",
			"var.armor_left_arm_tx": "fake_left_arm.tx",
			"var.armor_left_arm_ty": "fake_left_arm.ty+24",
			"var.armor_left_arm_tz": "fake_left_arm.tz",
			"var.armor_right_arm_rx": "fake_right_arm.rx",
			"var.armor_right_arm_ry": "fake_right_arm.ry",
			"var.armor_right_arm_rz": "fake_right_arm.rz",
			"var.armor_right_arm_tx": "fake_right_arm.tx",
			"var.armor_right_arm_ty": "fake_right_arm.ty+24",
			"var.armor_right_arm_tz": "fake_right_arm.tz",
			"var.armor_body_rx": "main_body.rx",
			"var.armor_body_ry": "main_body.ry",
			"var.armor_body_rz": "main_body.rz",
			"var.armor_body_tx": "main_body.tx",
			"var.armor_body_ty": "main_body.ty+24",
			"var.armor_body_tz": "main_body.tz"
		}
	]
}