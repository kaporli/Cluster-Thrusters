{
    "credit": "Created by Semos for Freshly Modded",
    "animations": [
        {
            "var.aim": "0",
            "var.left_arm_idle_rx": "if(swing_progress!=0&&!is_right_handed,torad(-90+swing_progress),if(!is_riding&&!is_on_ground&&is_in_water,torad(-50)-cos(var.swim)/4*clamp(1-limb_speed*8,0,1)+(cos(var.swim+sin(var.swim))+torad(30))*clamp(limb_speed*8,0,1),if(is_riding,torad(-45),sin(var.ls)*limb_speed)-torad(head_yaw)/8)+torad(5)*var.pose+(-sin(-pi/3+var.r+var.b+sin(var.r+var.b))/6)*var.nov2+(sin(limb_swing/2)-pi/4)/2*if(is_hurt,-sin(hurt_time*pi/5)/6*hurt_time,0))",
            "var.left_arm_idle_ry": "if(!is_riding&&!is_on_ground&&is_in_water,torad(-30)+sin(var.swim+cos(var.swim)/4)*clamp(1-limb_speed*8,0,1)+(torad(-5)-cos(pi/8+var.swim+sin(var.swim)/2)/2+clamp(sin(var.swim),0,pi/2))*clamp(limb_speed*8,0,1),if(is_riding,torad(20),0)+torad(15)*clamp(limb_speed*4,0,1)-cos(var.r+var.b)/30)+torad(20)*var.pose",
            "var.left_arm_idle_rz": "if(!is_riding&&!is_on_ground&&is_in_water,cos(var.swim)/2+(torad(-20)-cos(var.swim)/2)*clamp(limb_speed*8,0,1),0)+torad(head_pitch)/14+torad(-8+0.5*var.pose)",
            "var.left_arm_idle_tx": "if(!is_riding&&!is_on_ground&&is_in_water,5.5,5)",
            "var.left_arm_idle_ty": "2",
            "var.left_arm_idle_tz": "if(!is_riding&&!is_on_ground&&is_in_water,0,-0.25)",
            "var.right_arm_idle_rx": "if(swing_progress!=0&&is_right_handed,torad(-90+swing_progress),if(!is_riding&&!is_on_ground&&is_in_water,torad(-50)-cos(var.swim)/4*clamp(1-limb_speed*8,0,1)+(cos(var.swim+sin(var.swim))+torad(30))*clamp(limb_speed*8,0,1),if(is_riding,torad(-45),-sin(var.ls)*limb_speed)+torad(head_yaw)/8)+torad(5)*var.pose+(-sin(-pi/3+var.r+var.b+sin(var.r+var.b))/6)*var.nov2+(sin(limb_swing/2)-pi/4)/2*if(is_hurt,-sin(hurt_time*pi/5)/6*hurt_time,0))",
            "var.right_arm_idle_ry": "if(!is_riding&&!is_on_ground&&is_in_water,torad(30)-sin(var.swim+cos(var.swim)/4)*clamp(1-limb_speed*8,0,1)+(torad(5)+cos(pi/8+var.swim+sin(var.swim)/2)/2+clamp(-sin(var.swim),-pi/2,0))*clamp(limb_speed*8,0,1),if(is_riding,-torad(20),0)-torad(15)*clamp(limb_speed*4,0,1)+cos(var.r+var.b)/30)-torad(20)*var.pose",
            "var.right_arm_idle_rz": "if(!is_riding&&!is_on_ground&&is_in_water,-cos(var.swim)/2+(torad(20)+cos(var.swim)/2)*clamp(limb_speed*8,0,1),0)-torad(head_pitch)/14+torad(8+0.5*var.pose)",
            "var.right_arm_idle_tx": "if(!is_riding&&!is_on_ground&&is_in_water,-5.5,-5)",
            "var.right_arm_idle_ty": "2",
            "var.right_arm_idle_tz": "if(!is_riding&&!is_on_ground&&is_in_water,0,-0.25)",
            "var.tool_right_arm_rx": "if(nbt(Status,raw:iregex:.*3b.*),right_arm.rx,torad(-35))",
            "var.tool_right_arm_ry": "if(nbt(Status,raw:iregex:.*3b.*),right_arm.ry,torad(0))",
            "var.tool_right_arm_rz": "if(nbt(Status,raw:iregex:.*3b.*),right_arm.rz,torad(0))",
            "var.tool_right_arm_tx": "if(nbt(Status,raw:iregex:.*3b.*),right_arm.tx,5.5)",
            "var.tool_right_arm_ty": "if(nbt(Status,raw:iregex:.*3b.*),right_arm.ty+24,30.5)",
            "var.tool_right_arm_tz": "if(nbt(Status,raw:iregex:.*3b.*),right_arm.tz,9.5)",
            "var.tool_left_arm_rx": "if(nbt(Status,raw:iregex:.*3b.*),left_arm.rx,torad(-35))",
            "var.tool_left_arm_ry": "if(nbt(Status,raw:iregex:.*3b.*),left_arm.ry,torad(0))",
            "var.tool_left_arm_rz": "if(nbt(Status,raw:iregex:.*3b.*),left_arm.rz,torad(0))",
            "var.tool_left_arm_tx": "if(nbt(Status,raw:iregex:.*3b.*),left_arm.tx,5.5)",
            "var.tool_left_arm_ty": "if(nbt(Status,raw:iregex:.*3b.*),left_arm.ty+24,30.5)",
            "var.tool_left_arm_tz": "if(nbt(Status,raw:iregex:.*3b.*),left_arm.tz,9.5)",
			"var.book_right_arm_rx":"var.right_arm_idle_rx",
			"var.book_right_arm_ry":"var.right_arm_idle_ry",
			"var.book_right_arm_rz":"var.right_arm_idle_rz",
			"var.book_right_arm_tx":"var.right_arm_idle_tx",
			"var.book_right_arm_ty":"var.right_arm_idle_ty+24",
			"var.book_right_arm_tz":"var.right_arm_idle_tz",
			"var.book_left_arm_rx":"var.left_arm_idle_rx",
			"var.book_left_arm_ry":"var.left_arm_idle_ry",
			"var.book_left_arm_rz":"var.left_arm_idle_rz",
			"var.book_left_arm_tx":"var.left_arm_idle_tx",
			"var.book_left_arm_ty":"var.left_arm_idle_ty+24",
			"var.book_left_arm_tz":"var.left_arm_idle_tz"
        }
    ]
}