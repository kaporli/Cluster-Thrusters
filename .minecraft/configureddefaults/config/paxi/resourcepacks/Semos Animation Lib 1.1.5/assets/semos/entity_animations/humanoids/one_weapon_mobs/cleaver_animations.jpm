{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{
			"var.aim":"0",
			"var.mace_right_arm_rx": "if(var.aggro>0.01&&swing_progress==0,torad(-30)+sin(age/6)/10,if(var.aggro>0.01&&swing_progress!=0,torad(40)-(todeg(-swing_progress/10)),torad(180)))",
			"var.mace_right_arm_ry": "if(var.aggro>0.01&&swing_progress==0,torad(-30),if(var.aggro>0.01&&swing_progress!=0,torad(20),torad(90)))",
			"var.mace_right_arm_rz": "if(var.aggro>0.01&&swing_progress==0,sin(age/8)/10,if(var.aggro>0.01&&swing_progress!=0,torad(-30),torad(-35)))",
			"var.mace_right_arm_tx": "if(var.aggro>0.01&&swing_progress==0,-5.75,if(var.aggro>0.01&&swing_progress!=0,-6.5,if(nbt(Inventory,raw:iregex:.*chestplate.*),6.5,5.5)))",
			"var.mace_right_arm_ty": "if(var.aggro>0.01&&swing_progress==0,24,if(var.aggro>0.01&&swing_progress!=0,26,34))",
			"var.mace_right_arm_tz": "if(var.aggro>0.01&&swing_progress==0,-0.25,if(var.aggro>0.01&&swing_progress!=0,-0.25,2.25))",
			"var.mace_left_arm_rx": "if(var.aggro>0.01&&swing_progress==0,torad(-30)+sin(age/6)/10,if(var.aggro>0.01&&swing_progress!=0,torad(40)-(todeg(-swing_progress/10)),torad(0)))",
			"var.mace_left_arm_ry": "if(var.aggro>0.01&&swing_progress==0,torad(30),if(var.aggro>0.01&&swing_progress!=0,torad(-20),torad(90)))",
			"var.mace_left_arm_rz": "if(var.aggro>0.01&&swing_progress==0,sin(age/8)/10,if(var.aggro>0.01&&swing_progress!=0,torad(30),torad(55)))",
			"var.mace_left_arm_tx": "if(var.aggro>0.01&&swing_progress==0,5.75,if(var.aggro>0.01&&swing_progress!=0,6.5,if(nbt(Inventory,raw:iregex:.*chestplate.*),6.5,5.5)))",
			"var.mace_left_arm_ty": "if(var.aggro>0.01&&swing_progress==0,24,if(var.aggro>0.01&&swing_progress!=0,26,23))",
			"var.mace_left_arm_tz": "if(var.aggro>0.01&&swing_progress==0,-0.25,if(var.aggro>0.01&&swing_progress!=0,-0.25,4.25))"
		},
		{
			"right_arm.rx": "var.mace_right_arm_rx+main_body.rx",
			"right_arm.ry": "var.mace_right_arm_ry+main_body.ry",
			"right_arm.rz": "var.mace_right_arm_rz+main_body.rz",
			"right_arm.tx": "var.mace_right_arm_tx+main_body.tx",
			"right_arm.ty": "var.mace_right_arm_ty+main_body.ty",
			"right_arm.tz": "var.mace_right_arm_tz+main_body.tz",			
			"left_arm.rx": "var.mace_left_arm_rx+main_body.rx",
			"left_arm.ry": "var.mace_left_arm_ry+main_body.ry",
			"left_arm.rz": "var.mace_left_arm_rz+main_body.rz",
			"left_arm.tx": "var.mace_left_arm_tx+main_body.tx",
			"left_arm.ty": "var.mace_left_arm_ty+main_body.ty",
			"left_arm.tz": "var.mace_left_arm_tz+main_body.tz"
		},
		{
			"fake_left_arm.sx": " clamp(-3+var.spell*6, 0, 1)",
			"fake_left_arm.sy": "  fake_left_arm.sx",
			"fake_left_arm.sz": "  fake_left_arm.sx",
			"fake_right_arm.sx": "clamp(-3+var.spell*6, 0, 1)",
			"fake_right_arm.sy": "fake_right_arm.sx",
			"fake_right_arm.sz": "fake_right_arm.sx"		
		}
	]
}