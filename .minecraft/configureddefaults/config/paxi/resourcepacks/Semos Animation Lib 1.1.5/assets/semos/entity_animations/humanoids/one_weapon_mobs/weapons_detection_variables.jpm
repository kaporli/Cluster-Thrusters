	"animations": [
		{
			"var.shield": "if(nbt(HandItems,raw:iregex:.*shield.*),1,0)"
		},		
		{
			"var.sword": "if(nbt(HandItems,raw:iregex:.*sword.*),1,0)",
			"var.bow": "if(nbt(HandItems,raw:iregex:.*bow.*),1,0)",
			"var.crossbow": "if(nbt(HandItems,raw:iregex:.*crossbow.*),1,0)",
			"var.axe": "if(nbt(HandItems,raw:iregex:.*axe.*),1,0)",
			"var.executionner": "if(nbt(HandItems,raw:iregex:.*cleaver.*),1,0)"
		}

	]
}