{
	"credit": "CreatedbySemosforFreshlyModded",
	"animations": [
		{
			"varb.is_swiming": "is_in_water&&!is_on_ground&&!is_riding",
			"var.cross_arms": "if(is_in_water,0,varb.show_item,1,limb_speed>0.1,0,!varb.sleeping,sin((10*sin(0.5*(random(id)+age/200)-1)))+sin(5*(random(id)+age/200)-1),0)",
			"varb.arm_crossed": "var.cross_arms>0"
		},
		{
			"right_arms_top.rx": "if(varb.is_swiming,torad(-50)-cos(var.swim)/4*clamp(1-limb_speed*8,0,1)+(cos(var.swim+sin(var.swim))+torad(30))*clamp(limb_speed*8,0,1),varb.arm_crossed,torad(-45),is_riding,torad(-45),-sin(var.ls)*limb_speed+torad(head_yaw)/8+torad(5)*var.pose+(-sin(-pi/3+var.r+var.b+sin(var.r+var.b))/6)*var.nov2+(sin(limb_swing/2)-pi/4)/2*if(is_hurt,-sin(hurt_time*pi/5)/6*hurt_time,0))",
			"right_arms_top.ry": "if(varb.arm_crossed,0,if(varb.is_swiming,torad(30)-sin(var.swim+cos(var.swim)/4)*clamp(1-limb_speed*8,0,1)+(torad(5)+cos(pi/8+var.swim+sin(var.swim)/2)/2+clamp(-sin(var.swim),-pi/2,0))*clamp(limb_speed*8,0,1),if(is_riding,-torad(20),0)-torad(15)*clamp(limb_speed*4,0,1)+cos(var.r+var.b)/30)-torad(5)*var.pose)",
			"right_arms_top.rz": "if(varb.arm_crossed,main_body.rz,if(varb.is_swiming,-cos(var.swim)/2+(torad(20)+cos(var.swim)/2)*clamp(limb_speed*8,0,1),0)-torad(head_pitch)/14+torad(8+0.5*var.pose))",
			"right_arms_top.tx": "if(varb.is_swiming,-5,-4.99)",
			"right_arms_top.ty": "if(varb.arm_crossed,24.3,if(varb.is_swiming,23.5,if(is_riding,23.5,24.3)))+main_body.ty",
			"right_arms_top.tz": "if(varb.arm_crossed,-1.5,if(varb.is_swiming,-1,-0.5))+0.4+main_body.tz",
			"right_arms_bottom.rz": "if(varb.arm_crossed,torad(-90),torad(0))",
			"left_arms_top.rx": "if(varb.is_swiming,torad(-50)-cos(var.swim)/4*clamp(1-limb_speed*8,0,1)+(cos(var.swim+sin(var.swim))+torad(30))*clamp(limb_speed*8,0,1),varb.arm_crossed,torad(-45),is_riding,torad(-45),sin(var.ls)*limb_speed-torad(head_yaw)/8+torad(5)*var.pose+(-sin(-pi/3+var.r+var.b+sin(var.r+var.b))/6)*var.nov2+(sin(limb_swing/2)-pi/4)/2*if(is_hurt,-sin(hurt_time*pi/5)/6*hurt_time,0))",
			"left_arms_top.ry": "if(varb.arm_crossed,0,if(varb.is_swiming,torad(-30)+sin(var.swim+cos(var.swim)/4)*clamp(1-limb_speed*8,0,1)+(torad(-5)-cos(pi/8+var.swim+sin(var.swim)/2)/2+clamp(sin(var.swim),0,pi/2))*clamp(limb_speed*8,0,1),if(is_riding,torad(20),0)+torad(15)*clamp(limb_speed*4,0,1)-cos(var.r+var.b)/30)+torad(5)*var.pose)",
			"left_arms_top.rz": "if(varb.arm_crossed,main_body.rz,if(varb.is_swiming,cos(var.swim)/2+(torad(-20)-cos(var.swim)/2)*clamp(limb_speed*8,0,1),0)+torad(head_pitch)/14+torad(-8+0.5*var.pose))",
			"left_arms_top.tx": "if(varb.is_swiming,5,4.99)",
			"left_arms_top.ty": "if(varb.arm_crossed,24.3,if(varb.is_swiming,23.5,if(is_riding,23.5,24.3)))+main_body.ty",
			"left_arms_top.tz": "if(varb.arm_crossed,-1.5,if(varb.is_swiming,-1,-0.5))+0.4+main_body.tz",
			"left_arms_bottom.rz": "if(varb.arm_crossed,torad(90),torad(0))"
		},
		{
			"arms.ty": "5"
		}
	]
}