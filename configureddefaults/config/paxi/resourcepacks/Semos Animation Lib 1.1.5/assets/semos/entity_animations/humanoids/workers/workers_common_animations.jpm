{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{
			"fake_right_arm.rx": "if(is_right_handed&&nbt(Status,raw:iregex:.*3b.*),right_arm.rx,var.right_arm_idle_rx+main_body.rx)",
			"fake_right_arm.ry": "if(is_right_handed&&nbt(Status,raw:iregex:.*3b.*),right_arm.ry,var.right_arm_idle_ry+main_body.ry)",
			"fake_right_arm.rz": "if(is_right_handed&&nbt(Status,raw:iregex:.*3b.*),right_arm.rz,var.right_arm_idle_rz+main_body.rz)",
			"fake_right_arm.tx": "if(is_right_handed&&nbt(Status,raw:iregex:.*3b.*),right_arm.tx,var.right_arm_idle_tx+main_body.tx)",
			"fake_right_arm.ty": "if(is_right_handed&&nbt(Status,raw:iregex:.*3b.*),right_arm.ty-24,var.right_arm_idle_ty+main_body.ty",
			"fake_right_arm.tz": "if(is_right_handed&&nbt(Status,raw:iregex:.*3b.*),right_arm.tz,var.right_arm_idle_tz+main_body.tz)",
			"fake_left_arm.rx": "if(!is_right_handed&&nbt(Status,raw:iregex:.*3b.*),left_arm.rx,var.left_arm_idle_rx+main_body.rx)",
			"fake_left_arm.ry": "if(!is_right_handed&&nbt(Status,raw:iregex:.*3b.*),left_arm.ry,var.left_arm_idle_ry+main_body.ry)",
			"fake_left_arm.rz": "if(!is_right_handed&&nbt(Status,raw:iregex:.*3b.*),left_arm.rz,var.left_arm_idle_rz+main_body.rz)",
			"fake_left_arm.tx": "if(!is_right_handed&&nbt(Status,raw:iregex:.*3b.*),left_arm.tx,var.left_arm_idle_tx+main_body.tx)",
			"fake_left_arm.ty": "if(!is_right_handed&&nbt(Status,raw:iregex:.*3b.*),left_arm.ty-24,var.left_arm_idle_ty+main_body.ty)",
			"fake_left_arm.tz": "if(!is_right_handed&&nbt(Status,raw:iregex:.*3b.*),left_arm.tz,var.left_arm_idle_tz+main_body.tz)"
		}
	]
}