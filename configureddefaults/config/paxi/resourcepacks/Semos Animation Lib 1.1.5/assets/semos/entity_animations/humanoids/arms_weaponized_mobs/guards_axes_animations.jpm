{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{
			"var.aim":"0",
			"var.axe_right_arm_rx": "if(var.aggro>0.01&&swing_progress==0,torad(sin(age/10)*5),if(var.aggro>0.01&&swing_progress!=0,clamp(torad(150)-(todeg(-swing_progress/10)),0,6),torad(-35)))",
			"var.axe_right_arm_ry": "if(var.aggro>0.01&&swing_progress==0,torad(sin(age/10)*5),if(var.aggro>0.01&&swing_progress!=0,torad(45)-sin(swing_progress*pi)*1.5,torad(0)))",
			"var.axe_right_arm_rz": "if(var.aggro>0.01&&swing_progress==0,torad(30),if(var.aggro>0.01&&swing_progress!=0,sin(age/8)/10,torad(0)))",
			"var.axe_right_arm_tx": "if(var.aggro>0.01&&swing_progress==0,-5.75,if(var.aggro>0.01&&swing_progress!=0,-6.5,if(nbt(Inventory,raw:iregex:.*(leggings|chestplate).*),6.5,5.5)))",
			"var.axe_right_arm_ty": "if(var.aggro>0.01&&swing_progress==0,26,if(var.aggro>0.01&&swing_progress!=0,26,30.5))",
			"var.axe_right_arm_tz": "if(var.aggro>0.01&&swing_progress==0,-0.25,if(var.aggro>0.01&&swing_progress!=0,-0.25,9.5))",
