{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{
			"var.nope": "clamp(-239+cos(var.r+age/411)*240,0,1)/2*clamp(1-limb_speed*4,0,1)+if(head.rz!=0,1,0)"
		},	
		{
			"right_brow.tx": "-2+if(is_child, ( cos(-pi/3 +var.r+var.b )/6 +0.05 )*var.nov2 +0.1*var.nov3,(cos(-pi/3 +var.r+var.b )/6 +0.05 )*var.nov2 +0.1*var.nov3)",
			"right_brow.ty": "-30+clamp(if(is_child, -0.25 -0.25*clamp(cos(var.r+age/120)*10, 0, 1), 0) +clamp(1 -sin(var.r+age /110)*4, -0.3, 0 ) +clamp(head_pitch/30*(1 -2*clamp(sin(var.r+age/73)*3, 0, 1)), -0.8, -0.3*clamp(sin(var.r+age/73)*3, 0, 1))*1.2 +clamp(-torad(head_yaw)/2, -0.5, 0.2)*(0.3+0.7*random(id))*clamp(-sin(var.r+age/80)*6, 0, 1) +(clamp(-torad(head_yaw)/2, -0.5, 0) +clamp( torad(head_yaw)/2, -0.5, 0))*clamp(-sin(var.r+age/80)*6, 0, 1) +(-1.2-1*random(id) +sin(pi/4+var.ls*2)/(1+random(id)*2)*limb_speed )*var.scared -sin(hurt_time*pi/10)*(1.5 +sin(limb_swing/3)) +( cos(-pi/3 +var.r+var.b )/1.5 -0.1 )*var.nov2 -0.2*var.nov1 +if(is_child, 0, 0.25)*var.nope +if(is_child, -0.75, 0)*clamp(limb_speed*6, 0, 1),-0.5,0.5)",
			"right_brow.rz": "(torad(-2 -5*random(id)) -sin(pi/4+var.ls*2)/12)*var.scared +clamp( sin(var.r+age /110), torad(-5), 0)/3 -torad(5*random(id))/3*clamp(-4 +sin(var.r +age/97)*8, 0, 1) +( cos(-pi/3 +var.r+var.b )/14 -torad(2) )*var.nov2",
			"left_brow.tx": "-right_brow.tx",
			"left_brow.ty": "-30+clamp(if(is_child, -0.25 -0.25*clamp(cos(var.r+age/120)*10, 0, 1), 0) +clamp(1 -sin(var.r+age /110)*4, -0.3, 0 ) +clamp(head_pitch/30*(1 -2*clamp(sin(var.r+age/73)*3, 0, 1)), -0.8, -0.3*clamp(sin(var.r+age/73)*3, 0, 1))*1.2 +clamp( torad(head_yaw)/2, -0.5, 0.2)*(0.3+0.7*random(id))*clamp(-sin(var.r+age/80)*6, 0, 1) +(clamp(-torad(head_yaw)/2, -0.5, 0) +clamp( torad(head_yaw)/2, -0.5, 0))*clamp(-sin(var.r+age/80)*6, 0, 1) +(-1.2-1*random(id) +sin(pi/4+var.ls*2)/(1+random(id)*2)*limb_speed )*var.scared -sin(hurt_time*pi/10)*(1.5 +sin(limb_swing/3)) +( cos(-pi/3 +var.r+var.b )/1.5 -0.1 )*var.nov2 -0.2*var.nov1 +if(is_child, 0, 0.25)*var.nope +if(is_child, -0.75, 0)*clamp(limb_speed*6, 0, 1),-0.5,0.5)",
			"left_brow.rz": " (torad( 2 +5*random(id) +sin(pi/2+var.ls*2)/12)*var.scared +clamp(-sin(var.r+age /110), 0, torad( 5))/3 +torad(5*random(id))/3*clamp(-4 +sin(var.r +age/97)*8, 0, 1) -( cos(-pi/3 +var.r+var.b )/14 -torad(2) )*var.nov2",
			"nose2.ty": "-28",
			"nose2.rx": "-sin(limb_swing/0.65)/4*limb_speed/1.2",
			"nose2.rz": "-sin(torad(-45)+limb_swing/1.3 )/4*limb_speed/1.2 -torad(head_yaw)/6",
			"mouth.tx": "(1-2*random(id))/1.2*var.nope",
			"mouth.ty": "-30+0.5*var.scared +0.1*clamp(-sin(var.r+age/100)*20, 0.2, 1) -0.1*var.nope",
			"mouth.rz": "(clamp(head_yaw/500, torad(-10), torad(10)) +torad(7)*clamp(-sin(-torad(1) +var.r+age/100)*20, 0, 1) )*(1-2*random(id))"
		},
		{
			"r_eye_pupil.visible": "!varb.sleeping&&!varb.blinking||(!is_right_handed&&is_aggressive&&(var.aim==1))",
			"l_eye_pupil.visible": "!varb.sleeping&&!varb.blinking||(is_right_handed&&is_aggressive&&(var.aim==1))",
			"right_eye_white.visible": "r_eye_pupil.visible",
			"left_eye_white.visible": "l_eye_pupil.visible",
			"r_eye_pupil.tx": " -0.25+clamp(0.5-head_yaw/(80 +160*var.ylook)+clamp(sin(var.r+age/27) +sin(var.r+age/16), -0.1, 0.1)*clamp(-20*2 -cos(var.r+age/125)*30*2, 0, 1)*clamp(59*4 -sin(var.r+age/187)*60*4, 0, 1) +clamp(sin(var.r +age/15)*6, -0.25, 0.25)*var.nov3 +(-sin(pi/4+var.r+age/10)*3 -0.3 )*clamp(var.nov1*4, 0, 1),-0.5,1)",
			"r_eye_pupil.ty": " clamp(head_pitch/80, -0.3 -0.2*random(id), 0.5)/(1 +clamp(sin(var.r+age/73)*3, 0, 1)*2) +clamp(sin(var.r+age/38) +sin(var.r+age/13), -0.1, 0.1)*clamp(-20*2 -cos(var.r+age/125)*30*2, 0, 1) -clamp(-24 +sin(var.r+age/100)*40, 0, 1)/10 -0.25 *var.nov3 +(-0.3 -sin(var.ls*2)/6)*var.scared +(-1 -cos(limb_swing/3)/2)*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0) +( -cos(var.r+var.b +sin(var.r+var.b) )/4 )*var.nov2 +clamp(2*var.nov1, 0, 0.3) -if(between(random(id), 0, 0.2), -torad(10)*clamp(sin(limb_speed*3), 0, 1), 0) +if(is_child, 0, 0.5)*var.nope +if(is_child, -0.25, 0)*clamp(limb_speed*6, 0, 1)",
			"l_eye_pupil.tx": "r_eye_pupil.tx",
			"l_eye_pupil.ty": "r_eye_pupil.ty",
			"r_eye_pupil.sx": "clamp(0.95-(r_eye_pupil.tx),0.8,1)+ -0.2*var.scared",
			"r_eye_pupil.sy": "clamp(1-(r_eye_pupil.ty),0.8,1)+ -0.2*var.scared",
			"l_eye_pupil.sx": "clamp(0.95-(l_eye_pupil.tx),0.8,1)+ -0.2*var.scared",
			"l_eye_pupil.sy": "clamp(1-(l_eye_pupil.ty),0.8,1)+ -0.2*var.scared",
			"right_eye_white.tx": "r_eye_pupil.tx",
			"right_eye_white.ty": "r_eye_pupil.ty",
			"right_eye_white.sx": "1-(r_eye_pupil.tx/10)+0.2*var.scared",
			"right_eye_white.sy": "1-(r_eye_pupil.ty/10)+0.2*var.scared",
			"left_eye_white.tx": "l_eye_pupil.tx",
			"left_eye_white.ty": "l_eye_pupil.ty",
			"left_eye_white.sx": "1-(l_eye_pupil.tx/10)+0.2*var.scared",
			"left_eye_white.sy": "1-(l_eye_pupil.ty/10)+0.2*var.scared"
		}
	]
}